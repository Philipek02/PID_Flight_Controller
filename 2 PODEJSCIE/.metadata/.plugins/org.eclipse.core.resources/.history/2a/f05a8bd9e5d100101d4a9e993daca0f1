#include "motors.h"

// ----------------------------------------------------------
// USTAWIENIA SPRZĘTOWE DLA TWOJEGO STM32L432KC
// TIM1 → CH1, CH2, CH3, CH4 sterują ESC
// ----------------------------------------------------------

extern TIM_HandleTypeDef htim1;
// htim1 musi być widoczny – HAL generuje go w main.c, więc używamy extern.

// Tablica aktualnych wartości PWM dla diagnostyki lub logów
static uint16_t motor_output_us[4] = {1000,1000,1000,1000};


// ----------------------------------------------------------
// FUNKCJA: motors_init()
// (opcjonalna – możesz użyć do dodatkowych ustawień, jeśli kiedyś potrzebne)
// ----------------------------------------------------------
void motors_arm(void)
{
    // Ustaw początkowe wartości PWM dla bezpieczeństwa
    motors_stop_all();
    HAL_Delay(2000);
}


// ----------------------------------------------------------
// FUNKCJA: motors_stop_all()
// Ustawia wszystkie silniki na minimalny sygnał (OFF)
// ----------------------------------------------------------
void motors_stop_all(void)
{
    for (int i = 1; i <= 4; i++)
        set_motor_us(i, MOTOR_MIN_US);
}

void motors_set_all_us(u_int16_t us)
{
    for (int i = 1; i <= MOTOR_COUNT; i++)
        set_motor_us(i, us);
}

// ----------------------------------------------------------
// FUNKCJA: set_motor_us()
// Ustawia PWM w mikrosekundach na danym silniku
// ----------------------------------------------------------
void set_motor_us(uint8_t motor_id, uint16_t us)
{
    // Zabezpieczenia
    if (motor_id < 1 || motor_id > 4) return;

    if (us < MOTOR_MIN_US) us = MOTOR_MIN_US;
    if (us > MOTOR_MAX_US) us = MOTOR_MAX_US;

    motor_output_us[motor_id - 1] = us;

    switch(motor_id)
    {
        case 1: htim1.Instance->CCR1 = us; break;
        case 2: htim1.Instance->CCR2 = us; break;
        case 3: htim1.Instance->CCR3 = us; break;
        case 4: htim1.Instance->CCR4 = us; break;
        default: break;
    }
}


// ----------------------------------------------------------
// FUNKCJA: mixer_update()
// Miksowanie sygnałów roll/pitch/yaw oraz throttle do 4 silników.
// Konfiguracja quad X:
//
//        (Front)
//      M1       M2
//
//      M3       M4
//        (Back)
//
// ----------------------------------------------------------
void mixer_update(float u_roll, float u_pitch, float u_yaw, uint16_t throttle_us)
{
    // Wyliczenie surowych wartości (float)
    float m1 = throttle_us + u_roll + u_pitch - u_yaw;
    float m2 = throttle_us - u_roll + u_pitch + u_yaw;
    float m3 = throttle_us - u_roll - u_pitch - u_yaw;
    float m4 = throttle_us + u_roll - u_pitch + u_yaw;

    // Ograniczenia + zapis wyjść PWM
    set_motor_us(1, (uint16_t)m1);
    set_motor_us(2, (uint16_t)m2);
    set_motor_us(3, (uint16_t)m3);
    set_motor_us(4, (uint16_t)m4);
}
