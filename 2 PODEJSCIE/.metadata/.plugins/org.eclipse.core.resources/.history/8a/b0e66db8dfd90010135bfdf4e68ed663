#include "stm32l4xx_hal.h"  // <-- jeśli masz inną serię, zmień na swoją (np. stm32f4xx_hal.h)
#include <string.h>

#define IBUS_FRAME_SIZE   32
#define IBUS_FAILSAFE_MS  100

// iBUS: [0]=0x20 (len=32), [1]=0x40, [2..29]=14 kanałów (LSB,MSB), [30..31]=checksum (LSB,MSB)
// checksum = 0xFFFF - (sum of first 30 bytes)

static uint8_t  rx_byte;
static uint8_t  frame[IBUS_FRAME_SIZE];
static uint8_t  idx = 0;

static uint16_t channels[IBUS_CHANNELS];
static uint32_t last_ok_ms = 0;

static uint32_t ok_cnt = 0;
static uint32_t bad_cnt = 0;

static void start_rx_it(void)
{
  // odbiór 1 bajtu w przerwaniu
  HAL_UART_Receive_IT(&huart1, &rx_byte, 1);
}

static bool ibus_validate_and_update(const uint8_t *f)
{
  if (f[0] != 0x20) return false;
  if (f[1] != 0x40) return false;

  uint16_t sum = 0;
  for (int i = 0; i < 30; i++) sum += f[i];

  uint16_t rx_chk = (uint16_t)f[30] | ((uint16_t)f[31] << 8);
  uint16_t calc  = (uint16_t)(0xFFFF - sum);

  if (rx_chk != calc) return false;

  for (int ch = 0; ch < IBUS_CHANNELS; ch++)
  {
    int o = 2 + ch * 2;
    channels[ch] = (uint16_t)f[o] | ((uint16_t)f[o + 1] << 8);
  }

  last_ok_ms = HAL_GetTick();
  ok_cnt++;
  return true;
}

void ibus_init(void)
{
  memset(channels, 0, sizeof(channels));
  idx = 0;
  ok_cnt = bad_cnt = 0;
  last_ok_ms = 0;

  start_rx_it();
}

uint16_t ibus_read_channel(uint8_t i)
{
  if (i >= IBUS_CHANNELS) return 0;
  return channels[i];
}

void ibus_get_channels(uint16_t out[IBUS_CHANNELS])
{
  memcpy(out, channels, sizeof(channels));
}

bool ibus_is_alive(void)
{
  uint32_t now = HAL_GetTick();
  return (last_ok_ms != 0) && ((now - last_ok_ms) < IBUS_FAILSAFE_MS);
}

uint32_t ibus_ok_frames(void)  { return ok_cnt; }
uint32_t ibus_bad_frames(void) { return bad_cnt; }

