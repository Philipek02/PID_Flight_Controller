#include "ibus.h"
#include "usart.h"      // tu jest zadeklarowany huart
#include "stm32l4xx_hal.h"

#define IBUS_FRAME_SIZE   32
#define IBUS_CHANNELS     14
#define IBUS_FAILSAFE_MS  100   // po ilu ms uznajemy, że sygnał znikł

static uint8_t  ibus_rx_buf[IBUS_FRAME_SIZE];
static uint16_t ibus_channels[IBUS_CHANNELS];
static uint32_t ibus_last_frame_time = 0;

volatile HAL_StatusTypeDef ibus_start_status;
volatile uint32_t ibus_uart_error;
volatile uint32_t ibus_cr1_after_start;

// --------------------------------------------------
// Prototyp funkcji wewnętrznej
// --------------------------------------------------
static void ibus_parse_frame(uint8_t *data);


// --------------------------------------------------
// Inicjalizacja modułu i start odbioru
// --------------------------------------------------
void ibus_init(void)
{
    ibus_start_status = HAL_UART_Receive_IT(&huart1, ibus_rx_buf, IBUS_FRAME_SIZE);

    ibus_uart_error = HAL_UART_GetError(&huart1);
    ibus_cr1_after_start = huart1.Instance->CR1;
}


// --------------------------------------------------
// Callback z HAL - wywoływany po odebraniu 32 bajtów
// --------------------------------------------------
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        ibus_parse_frame(ibus_rx_buf);
        HAL_UART_Receive_IT(&huart1, ibus_rx_buf, IBUS_FRAME_SIZE);
    }
}


void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        // czyścimy błąd ORE/FE/NE i restartujemy RX
        __HAL_UART_CLEAR_OREFLAG(huart);
        __HAL_UART_CLEAR_FEFLAG(huart);
        __HAL_UART_CLEAR_NEFLAG(huart);

        HAL_UART_AbortReceive_IT(&huart1);
        HAL_UART_Receive_IT(&huart1, ibus_rx_buf, IBUS_FRAME_SIZE);
    }
}

// --------------------------------------------------
// Parsowanie ramki IBUS
// data[0] = 0x20, data[1] = 0x40, data[2..] = kanały, na końcu checksum
// --------------------------------------------------
static void ibus_parse_frame(uint8_t *data)
{
    // Prosta weryfikacja nagłówka
    if (data[0] != 0x20 || data[1] != 0x40)
        return;

    // Sprawdzenie checksumy
    uint16_t checksum = 0xFFFF;
    for (int i = 0; i < IBUS_FRAME_SIZE - 2; i++)
    {
        checksum -= data[i];
    }

    uint16_t rx_checksum = data[IBUS_FRAME_SIZE - 2] |
                          (data[IBUS_FRAME_SIZE - 1] << 8);

    if (checksum != rx_checksum)
        return; // zła ramka, ignorujemy

    // Jeśli checksum OK, to dekodujemy kanały
    for (int ch = 0; ch < IBUS_CHANNELS; ch++)
    {
        int index = 2 + ch * 2;
        uint16_t value = data[index] | (data[index + 1] << 8);
        ibus_channels[ch] = value;
    }

    // Zapisujemy czas przyjścia ostatniej poprawnej ramki
    ibus_last_frame_time = HAL_GetTick();
}


// --------------------------------------------------
// Odczyt kanału
// ch: 0..13 -> CH1..CH14
// --------------------------------------------------
uint16_t ibus_read_channel(uint8_t ch)
{
    if (ch >= IBUS_CHANNELS)
        return 1500;   // neutral
    return ibus_channels[ch];
}


// --------------------------------------------------
// Sprawdzenie czy sygnał jest świeży
// --------------------------------------------------
bool ibus_is_signal_valid(void)
{
    uint32_t now = HAL_GetTick();
    return (now - ibus_last_frame_time) < IBUS_FAILSAFE_MS;
}
